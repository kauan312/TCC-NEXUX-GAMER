{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "es2022",
    "moduleResolution": "NodeNext",
    "strict": true,
    "rootDir":"./src",
    "outDir":"./dist",
    "esModuleInterop":true,
    "forceConsistentCasingInFileNames":true,
    "skipLibCheck": true,
  },
  "include":["src/**/*"]
}
